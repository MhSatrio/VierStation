{
  "name": "vierstation",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "VierStation - Airtable-style scientific research workspace with bioinformatics integrations",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "node --disable-warning=ExperimentalWarning --watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 tests/*.test.ts",
    "e2e": "node --disable-warning=ExperimentalWarning tests/e2e/run.ts",
    "live": "node --disable-warning=ExperimentalWarning tests/live/check.ts",
    "bench": "node --disable-warning=ExperimentalWarning tests/perf/bench.ts",
    "e2e:lab": "node --disable-warning=ExperimentalWarning tests/e2e/lab.ts",
    "e2e:explorer": "node --disable-warning=ExperimentalWarning --test --test-timeout=120000 tests/e2e/explorer.ts",
    "seed:example": "node --disable-warning=ExperimentalWarning scripts/seed-example.ts",
    "live:lab": "node --disable-warning=ExperimentalWarning tests/live/lab.ts",
    "identify": "node --disable-warning=ExperimentalWarning scripts/identify.ts"
  },
  "dependencies": {
    "@fontsource/jost": "^5.3.0",
    "3dmol": "^2.5.5",
    "cytoscape": "^3.30.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
