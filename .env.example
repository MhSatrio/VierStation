# Copy to .env. Real environment variables win over this file. NEVER commit .env.
PORT=8787
HOST=127.0.0.1
APP_URL=http://localhost:8787
# Where the database, uploads and the generated master key live
# VIERSTATION_DATA_DIR=./data
# Optional fixed 64-hex-char key for encrypting stored API keys (otherwise generated once into data/.master.key)
# VIERSTATION_MASTER_KEY=
# NCBI/PubChem ask for a contact address in automated requests – use a lab/role mailbox, not a personal one
VIERSTATION_CONTACT_EMAIL=
# Optional: raises the NCBI limit from 3 to 10 requests/second
NCBI_API_KEY=
# There are no accounts, no login and no e-mail sending. The server listens on this computer only (HOST=127.0.0.1) and answers only requests addressed to localhost.
# Extra host names you deliberately want to allow (e.g. a lab machine name behind a VPN), comma separated:
# VIERSTATION_ALLOWED_HOSTS=
# Start in 'work offline' mode (external databases are not contacted; fetches wait in the queue). The Network chip in the header switches it at any time.
# VIERSTATION_OFFLINE=1
# Do not fetch structure images automatically after discovery runs (they are still fetched when you open a record's image)
# VIERSTATION_NO_AUTO_IMAGES=1
API_RATE_PER_MIN=2400
MAX_UPLOAD_MB=25
JOB_CONCURRENCY=3
